	@Override
	public String assignBatchandSubjects(Long batchId, Long subjectId, Long lecturerId) {
		try {
			
		Batch batch = batchRepo.findById(batchId).orElseThrow();
		
		Subject subject = subjectRepo.findById(subjectId).orElseThrow();
		
		Lecturer lecturer = lecturerRepo.findById(lecturerId).orElseThrow();
		
		
		String bName = batch.getName();
		String sName = subject.getName();
		
		batch.getLecturers().add(lecturer);
		System.out.println(batch.getLecturers().toString());
		batchRepo.save(batch);
		
		lecturer.getBatchsAndSubjects().put(bName, sName);
		
		lecturer.getBatches().add(batch);
		lecturerRepo.save(lecturer);
		
		return "Batch And Subject Assigned Succesufully";
		}
		catch (Exception e) {
			return "e.Failed to Assigned Batch And Subject";
		}
	}
