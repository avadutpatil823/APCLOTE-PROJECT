		   		+ "If this login wasn't you, please reset your password immediately or contact our support team.\r\n"
		   		+ "\r\n"
		   		+ "Happy Learning,  \r\n"
		   		+ "The APCLOTE Team  \r\n"
		   		+ "support@apclote.com  ";
		   emailService.sendEmail(u.getEmail(), subject, body);
		  
		  
	 }
	 return response;
		
	}
	
	
	@Override
    public String sendOtp(String email) throws Exception {
        User user = userRepo.findByEmail(email);
        if (user == null) {
            throw new UserException("No user found with this email.");
        }

        String otp = String.valueOf(new Random().nextInt(900000) + 100000);
        LocalDateTime expiryTime = LocalDateTime.now().plusMinutes(5);

        Optional<OtpVerification> existing = otpRepo.findByEmail(email);
        OtpVerification otpEntity = existing.orElse(new OtpVerification());
        otpEntity.setEmail(email);
        otpEntity.setOtp(otp);
        otpEntity.setExpiryTime(expiryTime);
        otpRepo.save(otpEntity);

        String subject = "Your OTP for Password Reset";
        String body = "Hello " + user.getName() + ",\n\nYour OTP for resetting your password is: " + otp
                + "\nThis OTP will expire in 5 minutes.";
        emailService.sendEmail(email, subject, body);

        return "OTP sent to your registered email.";
    }

    // 🔹 New: Verify OTP and reset password
    @Override
    public String verifyOtp(String email, String otp, String newPassword) throws Exception {
        Optional<OtpVerification> otpData = otpRepo.findByEmail(email);
        if (otpData.isEmpty()) {
            throw new UserException("No OTP found for this email.");
        }

        OtpVerification otpEntity = otpData.get();

        if (!otpEntity.getOtp().equals(otp)) {
            throw new UserException("Invalid OTP.");
        }

        if (otpEntity.getExpiryTime().isBefore(LocalDateTime.now())) {
            throw new UserException("OTP expired.");
        }

        User user = userRepo.findByEmail(email);
        user.setPassword(encoder.encode(newPassword));
        userRepo.save(user);
        otpRepo.delete(otpEntity);

        return "Password reset successfully!";
    }
	
	
	

